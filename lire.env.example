# Copy to lire.env (chmod 600). Every value marked "required" must be set.

# --- Lire itself ---
# Password of the first admin account, created on first start (required). Generate one: openssl rand -base64 18
LIRE_PASSWORD=
# Signs session cookies (required). Generate one: openssl rand -hex 32
SESSION_SECRET=
# Username of that first admin account.
LIRE_ADMIN=admin
# Public address of Lire, used to detect a reverse proxy serving Kavita under /kavita on the same host.
PUBLIC_URL=
# Reverse proxies allowed to pass the client IP in X-Real-IP (used for login rate limiting).
TRUSTED_PROXIES=127.0.0.0/8,172.16.0.0/12

# --- Prowlarr (required) ---
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
# Newznab categories searched (7000 = Books).
PROWLARR_CATEGORIES=7000
# Categories a release must carry to count as manga / comics (comma separated ids). 7030 is the standard
# Books/Comics category; use your indexer's own category ids if it has dedicated manga or comics ones.
MANGA_CATEGORIES=7030
COMICS_CATEGORIES=7030

# Pack releases made of loose images into one CBZ per volume, and stop Lire's Kavita libraries from indexing
# loose images (otherwise Kavita lists such a series twice).
PACK_IMAGES=true

# How often followed series are checked for new volumes, in hours.
FOLLOW_INTERVAL_HOURS=12

# --- Release languages ---
# Language picked by default on a series page (fr, en, ja, es, it, de). Readers can switch per series; the choice is remembered.
RELEASE_LANG=fr
# Language of untagged releases per Prowlarr indexer id, e.g. "17:fr,5:en". Tags in titles always win.
INDEXER_LANGS=
# Same per category id, for indexers with language-specific categories, e.g. "100001:fr".
CATEGORY_LANGS=
# Other languages land in sibling folders (manga-lang/<code>, comics-lang/<code>) and get their own Kavita library,
# created automatically: mount <manga dir>-lang and <comics dir>-lang into Kavita as /manga-lang and /comics-lang.

# --- qBittorrent (required) ---
QBIT_URL=http://qbittorrent:8080
QBIT_USER=admin
QBIT_PASSWORD=
# Where qBittorrent saves each kind, as seen from the qBittorrent container.
MANGA_SAVE_ROOT=/data/manga
COMICS_SAVE_ROOT=/data/comics

# --- Kavita (required) ---
KAVITA_URL=http://kavita:5000
# Admin API key: Kavita > User settings > 3rd party clients.
KAVITA_API_KEY=
# Address readers open in their browser (add /kavita if Kavita runs with that base URL).
KAVITA_PUBLIC_URL=
# Library names and their folders as seen from the Kavita container.
KAVITA_LIBRARY=Mangas
KAVITA_MANGA_ROOT=/manga
KAVITA_COMICS_LIBRARY=Comics & BD
KAVITA_COMICS_ROOT=/comics

# --- Optional: local LLM (Ollama) translating synopses between French and English ---
OLLAMA_URL=
OLLAMA_MODEL=mistral:7b
